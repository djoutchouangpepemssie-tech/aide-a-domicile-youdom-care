# Variables d'environnement du site Youdom Care (docs/00 §6).
# Copiez ce fichier en .env.local pour le développement. Aucun secret ne doit entrer dans le dépôt :
# les valeurs réelles vivent dans Vercel (ou dans .env.local, ignoré par git).

# Adresse publique du site (canoniques, plans de site, données structurées)
NEXT_PUBLIC_SITE_URL=https://www.youdom-care.com

# Indexation : reste à "false" tant que la phase 9 n'est pas validée ; c'est Arcel qui passe à "true" (docs/07 §8)
SITE_INDEXABLE=false

# Vérification des consoles moteurs (docs/04 §2) : jetons fournis par Google Search Console
# (balise google-site-verification) et Bing Webmaster Tools (balise msvalidate.01). Vides : aucune balise.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Envoi des demandes par e-mail (Q-TECH-1) — route api/lead, jamais côté client.
# Fournisseur retenu par Arcel le 04/10/2026 : Resend, en SMTP (D-050, docs/MESSAGERIE_RESEND.md).
# L'hôte, le port et l'identifiant sont les mêmes pour tout le monde et ne sont pas des secrets ;
# seul SMTP_PASS, qui reçoit la clé d'API Resend, en est un : il ne vit que dans Vercel.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
LEADS_TO=contact@youdom-care.com
LEADS_FROM="Youdom Care — site <no-reply@youdom-care.com>"

# Optionnel : nombre maximal d'envois par adresse IP et par dix minutes (5 par défaut)
LEAD_RATE_LIMIT=

# Optionnel : futur CRM (webhook signé)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optionnel : anti-robots Cloudflare Turnstile sur les formulaires
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mesure d'audience sans donnée personnelle (D-029, src/lib/mesure/README.md, Q-TECH-8).
# NEXT_PUBLIC_MESURE_ACTIVE est lue au build : "true" et le navigateur envoie les quatre événements
# anonymes de docs/05 §9 à la route /api/mesure/ ; toute autre valeur et rien ne part.
# MESURE_WEBHOOK_URL : collecteur (Matomo, Plausible, point d'entrée maison) vers lequel la route
# relaie chaque événement validé, signé HMAC-SHA256 par MESURE_WEBHOOK_SECRET (en-tête X-Signature).
# Sans adresse, la route répond 204 et ne stocke rien.
NEXT_PUBLIC_MESURE_ACTIVE=false
MESURE_WEBHOOK_URL=
MESURE_WEBHOOK_SECRET=
# Optionnel : événements acceptés par adresse et par dix minutes (120 par défaut)
MESURE_RATE_LIMIT=

# IndexNow (docs/04 §2) : clé de 8 à 128 caractères (a-z, A-Z, 0-9, tiret), définie dans Vercel seulement.
# Au build, `prebuild` écrit public/<clé>.txt (jamais commité) ; `pnpm indexnow` soumet ensuite les
# adresses des plans de site. Sans clé : simulation, rien n'est envoyé.
INDEXNOW_KEY=

# Variables d'environnement du site Youdom Care (docs/00 §6).
# Copiez ce fichier en .env.local pour le développement. Aucun secret ne doit entrer dans le dépôt :
# les valeurs réelles vivent dans Vercel (ou dans .env.local, ignoré par git).

# Adresse publique du site (canoniques, plans de site, données structurées)
NEXT_PUBLIC_SITE_URL=https://www.youdom-care.com

# Indexation : reste à "false" tant que la phase 9 n'est pas validée ; c'est Arcel qui passe à "true" (docs/07 §8)
SITE_INDEXABLE=false

# Envoi des demandes par e-mail (Q-TECH-1) — route api/lead, jamais côté client
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEADS_TO=contact@youdom-care.com
LEADS_FROM="Youdom Care — site <no-reply@youdom-care.com>"

# Optionnel : nombre maximal d'envois par adresse IP et par dix minutes (5 par défaut)
LEAD_RATE_LIMIT=

# Optionnel : futur CRM (webhook signé)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optionnel : anti-robots Cloudflare Turnstile sur les formulaires
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mesure d'audience (Q-TECH-2) : "plausible" | "matomo" | vide
NEXT_PUBLIC_ANALYTICS=

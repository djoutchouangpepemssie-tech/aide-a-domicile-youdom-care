# API Youdom Care — noms des variables, jamais de valeurs.
# Les valeurs se posent dans les variables d'environnement de l'hébergeur certifié HDS.

# Base de données. En production : un jeu de réplicas (M10 ou plus sur Atlas), dans une région HDS.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=youdom

# Poivre des empreintes d'authentification : 32 caractères au minimum, tiré au hasard.
# Volontairement vide ici : une valeur d'exemple finit toujours par arriver en production.
AUTH_PEPPER=

# Origines autorisées à appeler l'API — l'interface sur Vercel, et elle seule.
ALLOWED_ORIGINS=http://localhost:3000

# Atteste que la base est bien chez un hébergeur certifié HDS. L'API refuse de démarrer en
# production tant que cette variable ne vaut pas « true ». Voir docs/portal/ARCHITECTURE.md §4.
HDS_HOSTING_CONFIRMED=false

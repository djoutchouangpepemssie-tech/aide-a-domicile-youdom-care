# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/test-results
/test-results-*
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files : jamais de secret dans le dépôt, seul .env.example est versionné
.env*
!.env.example

# vercel
.vercel

# clé IndexNow : `prebuild` écrit public/<clé>.txt, qui ne doit jamais entrer dans le dépôt
# (.env.example, docs/04 §2). Les fichiers texte voulus sous public/ s'ajoutent en exception.
/public/*.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# données brutes des pipelines locaux (seules les données transformées et sourcées entrent dans data/local/) ;
# data/raw/README.md (sources, dates, licences) reste versionné
/data/raw/*
!/data/raw/README.md
/.lighthouseci/
/.next-dev-*.log
/tests/e2e/.mails/
# configuration Playwright jetable d'un poste (exécutable du navigateur local)
/.pw-audit.config.ts

# Aperçus d'e-mails (pnpm mail:preview) : jetables
.previews/
